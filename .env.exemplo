# Copie este arquivo para ".env" e ajuste os valores.

# Porta em que o sistema roda
PORTA=3000

# Usuário do painel do PCM (endereço /admin)
ADMIN_USUARIO=pcm

# Gere com:  npm run gerar-senha   (nunca grave a senha em texto puro aqui)
ADMIN_SENHA_HASH=

# Use "true" quando o site estiver em HTTPS (obrigatório em produção)
COOKIE_SEGURO=false

# Use "true" quando houver IIS, Nginx ou Cloudflare Tunnel na frente do Node
ATRAS_DE_PROXY=false

# Duração do login no painel, em horas
SESSAO_HORAS=8

# Pasta onde o banco de dados (relatorios.db) é gravado
# PASTA_DADOS=./data
